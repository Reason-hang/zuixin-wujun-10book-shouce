{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claim 论点卡（规则 v1.0 回写版，CHG-024）",
  "description": "与 spec/rules_v0.9.md R6 对齐：claim_id 带 U、字段名 claim_text/pillar_candidates/anchor.fingerprint、concept_key 命名式、status 生命周期。取代草案 v0.1（E1–E4 与生命周期经 D-25 确认保留）。卡文件为包装结构 {unit_id, book_code, extractor, batch_id, cards:[], x_disposals:[], unit_disposal, unit_disposal_reason}，本 schema 描述 cards 内的单卡。",
  "type": "object",
  "required": ["claim_id", "unit_id", "speaker", "claim_text", "anchor", "evidence_level", "pillar_candidates"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^C[A-Z0-9]{0,3}-[A-Z]{2}[0-9]?-U\\d{4}-\\d{2}$", "description": "正式批 C-<书码>-U<4位单元>-<2位卡序>；盲抽回归轮前缀 C2-/C4-/CG-/GR-"},
    "unit_id": {"type": "string", "pattern": "^[A-Z]{2}[0-9]?-U\\d{4}$"},
    "speaker": {"enum": ["吴军本人", "读者", "转述·第三方", "史实", "编校转录", "嘉宾", "待核"]},
    "claim_text": {"type": "string", "maxLength": 60},
    "quote": {"type": "string", "maxLength": 15, "description": "锚内连续子串直引，≤15 字（R8）"},
    "anchor": {
      "type": "object",
      "required": ["book_code", "start_line", "end_line", "sha1"],
      "properties": {
        "book_code": {"enum": ["SG1", "WJ2", "SG3", "GG", "JS", "SX", "GJ", "JJ", "FZ", "TD"]},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "锚区间各行 \\n 连接的 utf-8 SHA1"},
        "fingerprint": {"type": "array", "items": {"type": "string"}, "maxItems": 3, "description": "锚内子串指纹词"}
      }
    },
    "evidence_level": {"enum": ["E1", "E2", "E3", "E4"], "description": "E1原文明示/E2有据归纳(含吴军转述后取用)/E3应用推演(专名案例+可迁移机理)/E4证据不足不入主干"},
    "pillar_candidates": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"pattern": "^D\\d{2}-\\d$|^DT-待判$"}},
    "concept_key": {"type": "string", "description": "以吴军概括命名（如\"做减法\"，R1）；批内过渡编号 CK-xxxx 时必须附 concept_name"},
    "concept_name": {"type": "string", "description": "concept_key 为编号时的中文名"},
    "ability_tags": {"type": "array", "items": {"enum": ["思", "学", "沟", "做"]}, "maxItems": 2},
    "status": {"enum": ["已生成", "已核验", "已整合", "待修正"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"speaker": {"enum": ["读者", "史实"]}}}, "then": {"properties": {"evidence_level": {"not": {"const": "E1"}}}}}
  ]
}
